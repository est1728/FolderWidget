<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FolderWidget"
        android:supportsRtl="true">

        <!-- Config activity: pick apps + size (like the MIUI screenshot) -->
        <activity
            android:name=".FolderConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.FolderWidget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Config activity for the unlimited-apps stack widget -->
        <activity
            android:name=".FolderStackConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.FolderWidget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Popup activity: transparent overlay that "opens" like a folder -->
        <activity
            android:name=".FolderPopupActivity"
            android:exported="false"
            android:theme="@style/Theme.FolderWidget.Popup"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <!-- Widget 1: โฟลเดอร์ปกติ (จำกัดตามขนาดที่ลาก 4/9/16) -->
        <receiver
            android:name=".FolderWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_folder_info" />
        </receiver>

        <!-- Widget 2: โฟลเดอร์ไม่จำกัดจำนวนแอพ (โชว์ 3 + ไอคอนรวม) -->
        <receiver
            android:name=".FolderStackWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_folder_stack_info" />
        </receiver>

    </application>
</manifest>
