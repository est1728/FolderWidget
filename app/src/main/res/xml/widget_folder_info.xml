<?xml version="1.0" encoding="utf-8"?>
<!--
  หน้าตาของ widget ถูกกำหนดโดย "สไตล์ที่เลือกไว้ในแอพ" (ปกติ/ขยาย/XXL) เท่านั้น
  ไม่ได้อิงจากขนาด dp จริงบนหน้าโฮมอีกต่อไป (ดูเหตุผลใน FolderWidgetProvider)
  จึงปิดการลาก resize ไปเลย (resizeMode="none") ให้ผู้ใช้เปลี่ยนหน้าตาผ่านการ
  แก้ไขในแอพเท่านั้น เหมือนไอคอนแอพทั่วไป 1 ช่องกริด ไม่ต้องลาก resize
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="60dp"
    android:minHeight="60dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:resizeMode="none"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_folder"
    android:configure="com.est.folderwidget.FolderConfigActivity"
    android:widgetCategory="home_screen"
    android:label="@string/app_name"
    android:previewImage="@drawable/widget_preview_normal" />
