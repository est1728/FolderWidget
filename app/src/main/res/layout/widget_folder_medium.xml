<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_folder_card"
        android:padding="8dp">

        <GridLayout
            android:id="@+id/mini_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:columnCount="3"
            android:rowCount="3"
            android:alignmentMode="alignMargins">

            <ImageView android:id="@+id/mini_icon_1" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/mini_icon_2" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/mini_icon_3" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/mini_icon_4" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/mini_icon_5" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/mini_icon_6" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/mini_icon_7" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/mini_icon_8" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/mini_icon_9" android:layout_width="0dp" android:layout_height="0dp"
                android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp" android:scaleType="fitCenter" />
        </GridLayout>
    </FrameLayout>
</FrameLayout>
